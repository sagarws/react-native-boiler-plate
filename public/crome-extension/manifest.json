{
  "manifest_version": 3,
  "name": "Akshar Listen",
  "version": "1.0.0",
  "description": "Hear Akshar's read-aloud voice from your Android phone on this computer, over your own Wi-Fi.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Akshar Listen",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["offscreen", "storage"]
}

# TrackVid CMS - build-time configuration.
#
# electron-vite exposes MAIN_VITE_* keys to the Electron main process through
# import.meta.env and inlines them at build time. The .env file itself is NEVER
# packaged into the installer, so every build carries the values that were
# present when it was built.
#
# Copy this file to `.env` and adjust. `.env` is git-ignored.

# TrackVid API root, without a trailing slash. `/api` is appended automatically.
#
# ONE ADDRESS FOR EVERYTHING. The same host serves the releases, so this value
# is also electron-builder's publish.url:
#   {host}/api/...       every call the app makes
#   {host}/latest.yml    electron-updater appends this; baked into app-update.yml
#                        at package time and PERMANENT for every copy shipped
#                        from that build - a wrong value cannot be fixed remotely
#   {host}/cms/version   the policy feed the app polls once per launch
#                        ({ success, versionName, downloadUrl, mandatory, ... })
#
# Because of that permanence, `npm run build:win` / `build:mac` REFUSE to package
# while this points at localhost or plain http - see scripts/package.cjs. Switch
# it to the public host before cutting installers.
# Local development:
MAIN_VITE_API_BASE_URL="http://localhost:8000"
# MAIN_VITE_API_BASE_URL="https://accomplished-languages-admission-jonathan.trycloudflare.com"
# Production:
# MAIN_VITE_API_BASE_URL="https://api.trackvid.in"

# How long any single API call may take before it is aborted (milliseconds).
MAIN_VITE_API_TIMEOUT_MS="20000"

# Dev only: run a second checkout beside another one. Gives it its own
# userData folder (<userData>-<profile>) and single-instance lock. Ignored in
# packaged builds.
# MAIN_VITE_DEV_PROFILE="dev2"

# Login prefill. Fills the sign-in form in EVERY build - development and
# packaged alike.
#
# DEVELOPMENT ONLY. LoginPage reads these behind `import.meta.env.DEV`, so they
# are dead-stripped from packaged builds and never reach app.asar.
#
# THIS FILE IS COMMITTED. Whatever is written here is public the moment it is
# pushed, and stays public in the history even after it is changed — so it
# takes a placeholder, never a working login, not even a throwaway one. Put the
# real value in .env, which is git-ignored.
RENDERER_VITE_LOGIN_EMAIL=""
RENDERER_VITE_LOGIN_PASSWORD=""


# Binary download mirrors. GitHub's release CDN (objects.githubusercontent.com)
# fails its TLS handshake from some networks - the symptom is a packaging run
# that dies with "read ECONNRESET" straight after the electron download, even
# though github.com itself is reachable and the electron zip is already cached
# (the failing request is the checksum file fetched alongside it).
#
# scripts/package.cjs loads these into the environment before electron-builder
# runs. Remove them if your network reaches GitHub's CDN directly.
ELECTRON_MIRROR="https://registry.npmmirror.com/-/binary/electron/"
ELECTRON_BUILDER_BINARIES_MIRROR="https://registry.npmmirror.com/-/binary/electron-builder-binaries/"
MAIN_VITE_USE_BACKEND_FOR_SESSION_UPDATE=false
MAIN_VITE_SESSION_UPDATE_AUTOMATICALLY=true
# Show the browser while it signs in. Headless unless exactly "false".
# CMS reads only MAIN_VITE_* keys; this is published to process.env.HEADLESS
# for @trackvid/automation-core at startup. Requires a rebuild to take effect.
MAIN_VITE_HEADLESS=true

# The mailbox Flipkart and Tata CliQ email one-time codes to — the SAME inbox
# the automation server reads.
#
# Set these and the app reads Gmail itself over IMAP, so a sign-in that raises a
# code needs nothing else running. Leave them empty and both platforms ask
# TrackVid, which asks the automation server — which must then be up.
#
# CMS reads only MAIN_VITE_* keys; these are published to process.env as
# GMAIL_IMAP_USER / GMAIL_IMAP_PASSWORD for @trackvid/automation-core at startup.
#
# ONE INBOX SERVES EVERY SELLER. Put them in your own .env, never in a build
# that is handed out — a packaged app carrying them gives every installation the
# whole mailbox. Use a Gmail APP PASSWORD, not the account password.
MAIN_VITE_GMAIL_IMAP_USER=
MAIN_VITE_GMAIL_IMAP_PASSWORD=

# Old TrackVid CMS installers are deleted from Downloads on every launch. When
# at least one goes, the company name and the count are POSTed here, once per
# launch. The endpoint is public — no key. Leave blank to send nothing.
# Local: http://localhost:3100/api/installer-cleanup
MAIN_VITE_INSTALLER_REPORT_URL=https://ocean-management-vsor.onrender.com/api/installer-cleanup

# Switch claim filing off on this machine.
#
# "true": a claim this app is asked to file is NOT processed — no browser, no
# sign-in, no uploads. It is marked Failed at once, the backend charges one
# attempt, and the script error reads "MAIN_VITE_DISABLE_SUBMIT is disable".
# "false" (or unset): claims are filed for real.
#
# Opt-in: only the exact string "true" turns it on.
MAIN_VITE_DISABLE_SUBMIT=false

# Where claim evidence lives. The AJIO claim flow builds its attachment URL by
# hand from these two; unset, it fetches s3.undefined.amazonaws.com/undefined.
# Defaults match the server, so only override for a different bucket.
MAIN_VITE_AWS_BUCKET_REGION=ap-south-1
MAIN_VITE_AWS_BUCKET_NAME=trackvid

# Myntra reads ONLY this key — MAIN_VITE_HEADLESS does not apply to it.
#
# Its window is a working requirement of the sign-in, not something you turn on
# to watch, so it must not change when you flip the machine-wide setting for a
# debugging session. Unset means headless. Only the exact string "false" shows
# a window.
# MAIN_VITE_MYNTRA_HEADLESS=false
#
# Every other platform has the same style of key (MAIN_VITE_AJIO_HEADLESS, …),
# but those DO fall through to MAIN_VITE_HEADLESS when unset.

# Patch the manual capture page to look more like Chrome (defines window.chrome).
#
# OPT-IN, and leave it off unless a capture fails without it. It needs the
# DevTools Protocol, which the page can detect — a standard anti-bot check — so
# it can read as MORE automated, not less. Myntra's landing page stopped
# enabling its Login button with this on.
# MAIN_VITE_CAPTURE_PAGE_PATCHES=true

# "Impersonate" tab on the login screen — sign in as any user id, no password.
# A support tool: only the exact value true turns it on, and the main process
# refuses the call when it is off. Leave it off in any build handed to customers.
IMPERSON_LOGIN=false

# Developer mode across restarts. Only the exact value true keeps it on after
# the app is closed; anything else opens every launch with it off, so an
# operator's machine never stays in the extra screens by accident. Baked in at
# build time, like IMPERSON_LOGIN.
DEV_MODE_PERSIST=false

# Re-capture an expired login and keep going, in every running process — Create
# Ticket, Auto claim, Proceed eligible claims, Refill, Check TAT, imports — for
# the platforms whose auto-login is ON (Monitor → isAutoLoginOnActiveSession).
# Off, those stop at the "re-capture the login" dialog or skip the account, as
# before. Platforms with auto-login off always do. Baked in at build time; only
# the exact value true turns it on.
AUTO_SESSION_CAPTURE_ON_RUNNIG_PROCESS=true

# Dev server port for the renderer (npm run dev). strictPort is on, so a busy
# port fails fast instead of silently moving. Unset falls back to 5173.
RENDERER_VITE_DEV_PORT=5173

# MAIN_VITE_ORDER_FILE_BASE_URL="http://localhost:8001"
# Production:
MAIN_VITE_ORDER_FILE_BASE_URL="https://file.trackvid.in"


TRACKVID_OBFUSCATE=true
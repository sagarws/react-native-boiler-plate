{
  "name": "trackvid-cms",
  "version": "0.0.17",
  "description": "Cross-platform Electron desktop CMS with a reusable CRUD architecture.",
  "license": "MIT",
  "author": "TrackVid",
  "private": true,
  "main": "out/main/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && node --experimental-websocket tests/e2e/smoke.cjs",
    "verify": "npm run typecheck && npm run lint && npm run verify:tokens && npm run test",
    "build": "npm run verify && electron-vite build && npm run verify:secrets && npm run obfuscate",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && node scripts/package.cjs --win --x64",
    "build:win:x64": "npm run build && node scripts/package.cjs --win --x64",
    "build:win:arm64": "npm run build && node scripts/package.cjs --win --arm64",
    "build:mac": "npm run build && node scripts/package.cjs --mac",
    "build:mac:x64": "npm run build && node scripts/package.cjs --mac --x64",
    "build:mac:arm64": "npm run build && node scripts/package.cjs --mac --arm64",
    "build:mac:universal": "npm run build && node scripts/package.cjs --mac --universal",
    "postinstall": "electron-builder install-app-deps",
    "verify:tokens": "node scripts/verify-tokens.cjs",
    "icons": "node scripts/build-icon-subset.cjs",
    "verify:secrets": "node scripts/verify-no-baked-secrets.cjs",
    "check:autofetch": "node --experimental-websocket scripts/check-autofetch.cjs",
    "release:mac": "npm run build && node scripts/package.cjs --mac --require-signing",
    "release:win": "npm run build && node scripts/package.cjs --win --x64 --require-signing",
    "obfuscate": "node scripts/obfuscate.cjs"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@floating-ui/react": "0.27.16",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@mui/lab": "7.0.1-beta.19",
    "@mui/material": "7.3.6",
    "@mui/utils": "7.3.6",
    "@puppeteer/browsers": "^3.2.1",
    "@tanstack/react-table": "8.21.3",
    "@trackvid/automation-core": "file:./packages/TrackVid-Automation-Core",
    "axios": "^1.20.0",
    "classnames": "2.5.1",
    "dayjs": "^1.11.23",
    "electron-updater": "6.8.9",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.6",
    "imap": "^0.8.19",
    "imapflow": "2.4.2",
    "jspdf": "4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.40.0",
    "mailparser": "^3.9.19",
    "nodemailer": "10.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "puppeteer-core": "^25.9.0",
    "react": "19.2.8",
    "react-colorful": "5.6.1",
    "react-dom": "19.2.8",
    "react-perfect-scrollbar": "1.5.8",
    "react-toastify": "11.0.5",
    "selenium-webdriver": "^4.48.0",
    "socket.io-client": "^4.8.3",
    "ws": "8.21.3",
    "xlsx": "^0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "javascript-obfuscator": "^4.2.2",
    "tailwindcss": "4.3.3",
    "tailwindcss-logical": "4.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@jitsi/robotjs": "^0.6.24"
  }
}
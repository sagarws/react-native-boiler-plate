# Copy to .env.development.local (gitignored). Values are never committed.
PORT=8100
NODE_ENV=development
MONGO_URI=
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
# Set to true only on the production server. Without it the app refuses to start against the `prod` database.
ALLOW_PROD_DB=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=
# Realtime: this server does not own Socket.IO yet (Phase 5); emits are forwarded to legacy.
REALTIME_INTERNAL_URL=http://localhost:8000/internal/realtime/broadcast
REALTIME_INTERNAL_TOKEN=

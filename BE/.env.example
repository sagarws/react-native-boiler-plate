# TrackVid new server (NestJS + Fastify) — environment template, KEY NAMES ONLY.
# Use the SAME values as the legacy TrackVid-BE server (AWS, Redis, JWT, email, payments, Google, …):
# many legacy modules read these at load time. Copy into BE/.env (or the process manager env) on the server.
# Never commit values. Never place a .env inside BE/legacy or BE/dist/legacy.
# New-server only: ORDER_SERVER_PORT (default 8101), ALLOW_PROD_DB=true on the production host,
# LEGACY_BACKGROUND=on to run legacy workers/crons/sockets in this process (see PROGRESS.md cutover).

# ---- Server
PORT=
MASTER_IMPORT_PORT=
FILE_SERVER_PORT=
ORDER_SERVER_PORT=
EMAIL_AUTOMATION_SERVER_PORT=
NODE_ENV=
MODE=
BASE_URL=
FRONTEND_URL=
CLIENT_ORIGIN=
SERVICE_NAME=

# ---- MongoDB
MONGO_URI=
MONGO_MAX_POOL_SIZE=
MONGO_MIN_POOL_SIZE=
CONNECT_MONO_BY_API=
MONGO_API_URL=
MONGO_API_KEY=
ALLOW_PROD_DB=

# ---- Redis
REDIS_HOST=
REDIS_PORT=

# ---- Auth / JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_INVITATION_EXPIRES_IN=
ENCRYPTION_KEY=
ENCRYPTION_IV=

# ---- AWS S3
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

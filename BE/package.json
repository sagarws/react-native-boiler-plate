    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-fastify": "^11.2.10",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.21.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.9",
    "bullmq": "^5.21.2",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "etag": "^1.8.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",

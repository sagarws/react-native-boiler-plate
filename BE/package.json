{
  "name": "trackvid-be-nest",
  "version": "0.1.0",
  "private": true,
  "description": "TrackVid backend ported from Express to NestJS + Fastify (strangler migration).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest",
    "test:contract": "jest --config test/contract/jest.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-fastify": "^11.2.10",
    "aws-sdk": "^2.1693.0",
    "body-parser": "^1.20.9",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "etag": "^1.8.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "finalhandler": "^1.3.2",
    "fresh": "^0.5.2",
    "generate-password": "^1.7.1",
    "ioredis": "^5.11.1",
    "joi": "^17.13.9",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.31.0",
    "moment-timezone": "^0.5.48",
    "mongoose": "^8.24.8",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^6.10.1",
    "qs": "^6.16.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^10.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/etag": "^1.8.4",
    "@types/express": "^4.17.25",
    "@types/finalhandler": "^1.2.4",
    "@types/fresh": "^0.5.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "@types/qs": "^6.15.1",
    "jest": "^29.7.0",
    "mingo": "^6.4.15",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"

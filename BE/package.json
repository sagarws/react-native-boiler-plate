{
  "name": "trackvid-be-nest",
  "version": "0.1.0",
  "private": true,
  "description": "TrackVid backend ported from Express to NestJS + Fastify (strangler migration).",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-legacy-assets.js",
    "start": "node dist/src/main.js",
    "start:dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest",
    "test:contract": "jest --config test/contract/jest.config.js",
    "start:order-server": "node dist/src/order-server/main.js",
    "legacy:local": "node scripts/run-legacy-local.js",
    "seed:local": "node scripts/seed-local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",

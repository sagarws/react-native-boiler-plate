<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The release app is offline by design: OCR runs on-device and nothing
         is uploaded. Removing INTERNET (including any declared by libraries,
         such as ML Kit's usage logging) makes that a platform guarantee
         rather than a promise. Debug keeps it for Metro. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>

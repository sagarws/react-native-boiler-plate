<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network policy for release builds.

         INTERNET is kept for user-started features only:
         - "Speak with Translation" sends the extracted text (never a
           screenshot) to the Google Gemini API with the user's own key,
           after explicit opt-in.
         - Remote Access: end-to-end encrypted sessions with the user's own
           devices, through the relay.
         - Utility → YouTube Downloader fetches the video page and streams
           for a link the user pastes (nothing is uploaded).
         Every other mode is fully on-device.

         ML Kit bundles Google's datatransport usage-logging uploader. While
         the app had no INTERNET permission it could not send anything; now
         that translation needs the network, its backend discovery and upload
         schedulers are removed so it still sends nothing.

         ACCESS_NETWORK_STATE must NOT be removed here (it once was): Remote
         Access needs it (main manifest), and WebRTC aborts the whole app with
         a native crash when it starts a video connection without it. The
         uploader stays off because its services below are removed. -->

    <application>
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:node="remove" />
    </application>
</manifest>

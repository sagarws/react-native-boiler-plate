<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only need this to reach Metro. Release builds strip it
         (src/release/AndroidManifest.xml), so the shipped app cannot make
         network requests at all — screenshots and text never leave the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: lets the capture service's ongoing notification show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Utility: QR/barcode scanner and AR Measure (asked only when one of
         them is opened). Not required: the app installs on phones without a
         camera or ARCore, and those tools explain they're unavailable. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <!-- Utility: optional vibration in Speaker Water Eject. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Follow Up: "fill from contacts" on the contact form (asked on tap;
         without it the system picker is offered instead). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Follow Up: re-arm reminder alarms after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Display over other apps": draws the floating capture button. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android requires a foreground service of type mediaProjection while
         a screen-capture session is held. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- "Share voice to Chrome → All phone audio": Android gates playback
         capture behind RECORD_AUDIO (asked only when that option is chosen),
         and Android 14+ needs the microphone service type for it. Nothing is
         recorded from the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Screen recorder: merging a recording's parts after capture has ended
         runs as a short dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 11+ package visibility: lets the app list installed
         text-to-speech engines (to prefer Google Speech Services when present). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Long-pressing the floating button opens the latest capture.
             Not BROWSABLE, so web pages cannot trigger it. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="capture" />
        </intent-filter>
        <!-- The Manage Life widget opens Manage Life → Today. Not BROWSABLE. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="life" />
        </intent-filter>
        <!-- Follow Up reminder notifications open the contact. Not BROWSABLE. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="followup" />
        </intent-filter>
      </activity>

      <!-- AR Measure works where ARCore is available; elsewhere it explains why not. -->
      <meta-data android:name="com.google.ar.core" android:value="optional" />

      <!-- Utility: full-screen camera tools (not exported). -->
      <activity
        android:name=".utility.BarcodeScanActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
      <activity
        android:name=".utility.MeasureActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

      <!-- Follow Up reminders: fired by the app's own alarms only. -->
      <receiver
        android:name=".followup.ReminderReceiver"
        android:exported="false" />
      <receiver
        android:name=".followup.ReminderBootReceiver"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>

      <!-- Private files (attachments, scanned documents) handed to a viewer
           or the share sheet with one-off read grants. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

      <!-- Shows the system screen-capture consent dialog; no UI of its own. -->
      <!-- File Management: in-app video player (not exported). -->
      <activity
        android:name=".screenocr.VideoPlayerActivity"
        android:exported="false"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
      <activity
        android:name=".screenocr.CaptureConsentActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:noHistory="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />

      <!-- Manage Life home-screen widget. Exported for the launcher; quick-log
           broadcasts are only accepted with the widget's private token. -->
      <receiver
        android:name=".lifewidget.LifeWidgetProvider"
        android:exported="true"
        android:label="@string/life_widget_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <!-- Redraw for the new day when the clock or timezone changes. -->
            <action android:name="android.intent.action.TIME_SET" />
            <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/life_widget_info" />
      </receiver>

      <!-- Allow / Deny on the audio-sharing connection request notification. -->
      <receiver
        android:name=".screenocr.share.AudioShareActionReceiver"
        android:exported="false" />
      <service
        android:name=".screenocr.OverlayCaptureService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection|microphone" />

      <!-- Utility → Screen Recorder: its own floating button, consent and
           notification, independent of the OCR service above. Records only
           after Android's capture consent; microphone only when chosen. -->
      <service
        android:name=".recorder.RecorderService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection|microphone|dataSync" />
      <activity
        android:name=".recorder.RecorderConsentActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />
      <activity
        android:name=".recorder.ScreenshotEditorActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
        android:theme="@android:style/Theme.Material.NoActionBar" />

      <!-- Optional, for "Speak with auto-scroll" only: scrolls the app being
           read. Off until the user turns it on in Android's accessibility
           settings; the app never enables it. Reads no content. -->
      <service
        android:name=".screenocr.ScrollAccessibilityService"
        android:exported="true"
        android:label="@string/scroll_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
        <intent-filter>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
            android:name="android.accessibilityservice"
            android:resource="@xml/scroll_accessibility_service" />
      </service>
    </application>
</manifest>

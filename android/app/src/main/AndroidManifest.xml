<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only need this to reach Metro. Release builds strip it
         (src/release/AndroidManifest.xml), so the shipped app cannot make
         network requests at all — screenshots and text never leave the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: lets the capture service's ongoing notification show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Display over other apps": draws the floating capture button. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android requires a foreground service of type mediaProjection while
         a screen-capture session is held. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 11+ package visibility: lets the app list installed
         text-to-speech engines (to prefer Google Speech Services when present). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Long-pressing the floating button opens the latest capture.
             Not BROWSABLE, so web pages cannot trigger it. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="capture" />
        </intent-filter>
      </activity>

      <!-- Shows the system screen-capture consent dialog; no UI of its own. -->
      <activity
        android:name=".screenocr.CaptureConsentActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:noHistory="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />

      <service
        android:name=".screenocr.OverlayCaptureService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection" />

      <!-- Optional, for "Speak with auto-scroll" only: scrolls the app being
           read. Off until the user turns it on in Android's accessibility
           settings; the app never enables it. Reads no content. -->
      <service
        android:name=".screenocr.ScrollAccessibilityService"
        android:exported="true"
        android:label="@string/scroll_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
        <intent-filter>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
            android:name="android.accessibilityservice"
            android:resource="@xml/scroll_accessibility_service" />
      </service>
    </application>
</manifest>

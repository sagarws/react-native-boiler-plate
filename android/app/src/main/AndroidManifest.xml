<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only need this to reach Metro. Release builds strip it
         (src/release/AndroidManifest.xml), so the shipped app cannot make
         network requests at all — screenshots and text never leave the device. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: lets the capture service's ongoing notification show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Utility: QR/barcode scanner and AR Measure (asked only when one of
         them is opened). Not required: the app installs on phones without a
         camera or ARCore, and those tools explain they're unavailable. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Utility → Scanner gun: the phone acts as a Bluetooth keyboard (HID device). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <!-- Utility: optional vibration in Speaker Water Eject. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Reminders and Utility timers (shared alarm engine, alarms/):
         on-time alarms; the user can deny exact alarms (Android 14+ default),
         then alarms are inexact and the screens say so. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Ringing continues with the app closed: a foreground service of type
         systemExempted (allowed with exact alarms) or mediaPlayback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- High-priority alarms: lock-screen alarm screen (the user can revoke it). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Follow Up: "fill from contacts" on the contact form (asked on tap;
         without it the system picker is offered instead). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Follow Up: re-arm reminder alarms after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Display over other apps": draws the floating capture button. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android requires a foreground service of type mediaProjection while
         a screen-capture session is held. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- "Share voice to Chrome → All phone audio": Android gates playback
         capture behind RECORD_AUDIO (asked only when that option is chosen),
         and Android 14+ needs the microphone service type for it. Nothing is
         recorded from the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Screen recorder: merging a recording's parts after capture has ended
         runs as a short dataSync foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Share Live Camera: keeps the camera (and microphone, when chosen)
         streaming while the app is in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Remote Access: find other Featured App devices on this Wi-Fi (UDP
         broadcast on port 47801) and show this phone's address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 8D Audio Studio: reads the music library (asked when the library opens). -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11+ package visibility: lets the app list installed
         text-to-speech engines (to prefer Google Speech Services when present)
         and UPI payment apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Expense Tracker → Scan QR & Pay: lists the installed UPI apps so
             the user can pick one. The app only hands them a upi://pay link;
             no payment gateway, no credentials. -->
        <!-- The host must be declared too: UPI apps register for upi://pay,
             and a scheme-only query doesn't match their filters, so Android
             would keep them hidden. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" android:host="pay" />
        </intent>
        <!-- 8D Audio Studio → Other apps: shows a music app's name (not just
             its package) next to the audio session it announced. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Long-pressing the floating button opens the latest capture.
             Not BROWSABLE, so web pages cannot trigger it. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="capture" />
        </intent-filter>
        <!-- The Manage Life widget opens Manage Life → Today. Not BROWSABLE. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="life" />
        </intent-filter>
        <!-- Follow Up reminder notifications open the contact. Not BROWSABLE. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="followup" />
        </intent-filter>
        <!-- Reminder / timer alarms and photo widgets open their screens.
             Not BROWSABLE, so web pages cannot trigger them. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="rnboilerplate" android:host="reminders" />
            <data android:scheme="rnboilerplate" android:host="utility" />
            <data android:scheme="rnboilerplate" android:host="photo-widgets" />
        </intent-filter>
      </activity>

      <!-- AR Measure works where ARCore is available; elsewhere it explains why not. -->
      <meta-data android:name="com.google.ar.core" android:value="optional" />

      <!-- Utility: full-screen camera tools (not exported). -->
      <activity
        android:name=".utility.BarcodeScanActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
      <activity
        android:name=".utility.SightActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
      <activity
        android:name=".utility.MeasureActivity"
        android:exported="false"
        android:screenOrientation="portrait"
        android:configChanges="orientation|screenSize"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

      <!-- Photo Widget: home-screen photo widgets (any number, resizable).
           Exported for the launcher only; settings come from the app. -->
      <receiver
        android:name=".photowidget.PhotoWidgetProvider"
        android:exported="true"
        android:label="@string/photo_widget_label">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent-filter>
        <meta-data
          android:name="android.appwidget.provider"
          android:resource="@xml/photo_widget_info" />
      </receiver>
      <!-- The launcher opens this when a photo widget is added; must be exported. -->
      <activity
        android:name=".photowidget.PhotoWidgetConfigureActivity"
        android:exported="true"
        android:excludeFromRecents="true"
        android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
        <intent-filter>
          <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
        </intent-filter>
      </activity>
      <receiver
        android:name=".photowidget.PhotoWidgetPinReceiver"
        android:exported="false" />

      <!-- Shared alarm engine (Reminders, Utility timers). Fire / action
           receivers are only reached through the app's own PendingIntents. -->
      <receiver
        android:name=".alarms.AlarmReceiver"
        android:exported="false" />
      <receiver
        android:name=".alarms.AlarmActionReceiver"
        android:exported="false" />
      <receiver
        android:name=".alarms.AlarmRestoreReceiver"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        </intent-filter>
      </receiver>
      <service
        android:name=".alarms.AlarmRingService"
        android:exported="false"
        android:foregroundServiceType="systemExempted|mediaPlayback" />
      <activity
        android:name=".alarms.AlarmActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:launchMode="singleInstance"
        android:showWhenLocked="true"
        android:turnScreenOn="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

      <!-- Follow Up reminders: fired by the app's own alarms only. -->
      <receiver
        android:name=".followup.ReminderReceiver"
        android:exported="false" />
      <receiver
        android:name=".followup.ReminderBootReceiver"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>

      <!-- Private files (attachments, scanned documents) handed to a viewer
           or the share sheet with one-off read grants. -->
      <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.files"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
          android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/file_paths" />
      </provider>

      <!-- Shows the system screen-capture consent dialog; no UI of its own. -->
      <!-- File Management: in-app video player (not exported). -->
      <activity
        android:name=".screenocr.VideoPlayerActivity"
        android:exported="false"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
      <activity
        android:name=".screenocr.CaptureConsentActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:noHistory="false"
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />

      <!-- Manage Life home-screen widget. Exported for the launcher; quick-log
           broadcasts are only accepted with the widget's private token. -->
      <receiver
        android:name=".lifewidget.LifeWidgetProvider"
        android:exported="true"
        android:label="@string/life_widget_label">
        <intent-filter>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            <!-- Redraw for the new day when the clock or timezone changes. -->
            <action android:name="android.intent.action.TIME_SET" />
            <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        </intent-filter>
        <meta-data
            android:name="android.appwidget.provider"
            android:resource="@xml/life_widget_info" />
      </receiver>

      <!-- Allow / Deny on the audio-sharing connection request notification. -->
      <receiver
        android:name=".screenocr.share.AudioShareActionReceiver"
        android:exported="false" />
      <service
        android:name=".screenocr.OverlayCaptureService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection|microphone" />

      <!-- Utility → Screen Recorder: its own floating button, consent and
           notification, independent of the OCR service above. Records only
           after Android's capture consent; microphone only when chosen. -->
      <!-- Utility → YouTube Downloader: one download at a time in the
           foreground (progress notification with Cancel). -->
      <service
        android:name=".ytdownload.YtDownloadService"
        android:exported="false"
        android:foregroundServiceType="dataSync" />

      <!-- Share Live Camera: holds the app in the foreground while the
           WebRTC camera stream runs (ongoing notification with Stop). -->
      <service
        android:name=".livecamera.LiveCameraService"
        android:exported="false"
        android:foregroundServiceType="camera|microphone" />

      <!-- 8D Audio Studio player: Media3 MediaSessionService (media
           notification, lock screen, headset / Bluetooth controls). Exported
           so system media controllers can connect, as Media3 requires. -->
      <service
        android:name=".audiostudio.AudioStudioService"
        android:exported="true"
        android:foregroundServiceType="mediaPlayback">
        <intent-filter>
          <action android:name="androidx.media3.session.MediaSessionService" />
          <action android:name="android.media.browse.MediaBrowserService" />
        </intent-filter>
      </service>

      <!-- 8D Audio Studio → Other apps. Session effects: players announce
           their audio sessions with these broadcasts (exported: the senders
           are other apps; only a session id and package name are read). -->
      <receiver
        android:name=".systemaudio.SessionEffectReceiver"
        android:exported="true">
        <intent-filter>
          <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_SESSION" />
          <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_SESSION" />
        </intent-filter>
      </receiver>
      <!-- Playback capture → 8D engine, only after Android's capture consent
           (ongoing notification with Stop). microphone: Android 11+ needs it
           for a background AudioRecord; the microphone is never recorded. -->
      <service
        android:name=".systemaudio.SystemAudioCaptureService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection|microphone" />
      <activity
        android:name=".systemaudio.SystemAudioConsentActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />

      <service
        android:name=".recorder.RecorderService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection|microphone|dataSync" />
      <activity
        android:name=".recorder.RecorderConsentActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:theme="@android:style/Theme.Translucent.NoTitleBar" />
      <activity
        android:name=".recorder.ScreenshotEditorActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:taskAffinity=""
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
        android:theme="@android:style/Theme.Material.NoActionBar" />

      <!-- Optional, for "Speak with auto-scroll" only: scrolls the app being
           read. Off until the user turns it on in Android's accessibility
           settings; the app never enables it. Reads no content. -->
      <!-- 8D Audio Studio: independent "8D volume" for the hear-only-8D mode. -->
      <service
        android:name=".systemaudio.EightDVolumeService"
        android:exported="true"
        android:label="@string/eightd_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
        <intent-filter>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
            android:name="android.accessibilityservice"
            android:resource="@xml/eightd_volume_service" />
      </service>

      <service
        android:name=".screenocr.ScrollAccessibilityService"
        android:exported="true"
        android:label="@string/scroll_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
        <intent-filter>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
            android:name="android.accessibilityservice"
            android:resource="@xml/scroll_accessibility_service" />
      </service>

      <!-- Remote Access: carries out the taps, swipes and typing of a remote
           session the user allowed on this phone. Off until the user turns it
           on in Android's accessibility settings; the app never enables it. -->
      <service
        android:name=".remote.RemoteControlService"
        android:exported="true"
        android:label="@string/remote_service_label"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
        <intent-filter>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent-filter>
        <meta-data
            android:name="android.accessibilityservice"
            android:resource="@xml/remote_control_service" />
      </service>
      <!-- react-native-webrtc's screen-share foreground service (Remote Access
           host). Declared here as well so it is explicitly not exported. -->
      <service
        android:name="com.oney.WebRTCModule.MediaProjectionService"
        android:exported="false"
        android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>

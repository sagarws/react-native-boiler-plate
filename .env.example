# Copy to `.env` and fill in. `.env` is gitignored.
#
# These are read by react-native-config, which bakes them into generated
# NATIVE files — a Metro reload will not pick up a change here. After editing,
# rebuild: `npm run android` / `npm run ios`.

# Required. Backend base URL. No trailing slash.
API_BASE_URL=https://api.example.com

# Required. One of: development | staging | production
APP_ENV=development

# Optional. Leave blank to disable crash reporting.
SENTRY_DSN=

# Optional. File Management's default shared Google Drive (the share-chat
# server's GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN /
# GOOGLE_DRIVE_FOLDER_ID). Native-only (never read in JS). These end up inside
# the APK: use them only for private builds. Users can override them in
# Settings → File Management.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

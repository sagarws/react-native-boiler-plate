# Copy to .env (never commit it). Generate secrets with: openssl rand -hex 32

# The VPS public IP (MediaMTX advertises it to phones and browsers).
PUBLIC_IP=203.0.113.25
# What Caddy serves. No domain? Use the free sslip.io name for the IP
# (dots → dashes): Caddy gets a real Let's Encrypt certificate for it.
SITE_ADDRESS=203-0-113-25.sslip.io
# The base URL put in share links (same host as SITE_ADDRESS).
PUBLIC_URL=https://203-0-113-25.sslip.io

TOKEN_SECRET=
MTX_SECRET=

# TURN (optional; for networks that block UDP *and* TCP 8189). Reuse an
# existing coturn's static-auth-secret, or run the "turn" profile.
TURN_SECRET=
TURN_URLS=turn:203.0.113.25:3478?transport=udp,turn:203.0.113.25:3478?transport=tcp
STUN_URLS=stun:203.0.113.25:3478

# Limits (defaults shown)
MAX_STREAMS=50
MAX_STREAMS_PER_IP=3
MAX_VIEWERS_CAP=50
VIEWER_TOKEN_TTL_SEC=600
STREAM_OFFLINE_TTL_SEC=900
STREAM_MAX_LIFETIME_SEC=43200
